<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
  </packageSources>

  <!--
    The user's machine has PackageSourceMapping enabled (likely via a global NuGet.Config).
    If our packages are not mapped to a source, restore fails with NU1100 and reports that
    sources like nuget.org were "not considered".

    This repo-local config clears any inherited mappings and allows all packages from nuget.org.
  -->
  <packageSourceMapping>
    <clear />
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
  </packageSourceMapping>
</configuration>
